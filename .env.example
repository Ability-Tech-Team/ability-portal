# Ability Portal environment — sanitized example (tracked).
# For local use: cp .env.example .env.local (ignored by Git).

# Portal API (sign-in): finds the client an email address belongs to and signs
# in with that client's backend. Server-only, read at runtime: never prefix it
# with NEXT_PUBLIC_. An absolute https:// URL (http:// only for loopback or
# private-network hosts), without the /api path. Without it, sign-in reports
# that the service is unavailable. Each client's product addresses come from
# its login answer.
PORTAL_API_URL=http://localhost:4100

# Diagnostic (optional): the CRM's own API, e.g. https://crm-api.example.com.
# When set, the Ability CRM card opens /<locale>/token-check, which calls an
# authorized endpoint of this API with the access token, from the server and
# from the browser. Server-only. Leave empty to link to the CRM itself.
CRM_API_URL=

# Account service (forgot password, set password): built by Ability-Tech's
# backend team; contract in ../docs/ACCOUNT-SERVICE-API.md. Server-only values,
# read when the server starts: never prefix them with NEXT_PUBLIC_.
# Without them, the password pages report that the service is unavailable.
ACCOUNT_SERVICE_URL=http://localhost:3400
ACCOUNT_SERVICE_CLIENT_ID=ability-portal
# Issued by the backend team. Keep it in .env.local only, never committed.
ACCOUNT_SERVICE_CLIENT_SECRET=

# Parent domain of the Portal and both products in deployed environments, e.g.
# apps.ability-tech.com, so they share the access_token cookie. Leave empty for
# localhost, where the apps share cookies across ports.
SESSION_COOKIE_DOMAIN=
