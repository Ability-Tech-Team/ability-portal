# Ability Portal environment — sanitized example (tracked).
# For local use: cp .env.example .env.local (ignored by Git).
#
# Product destinations: where each product card links. They are public
# navigation metadata, not access decisions; each product enforces access.
#
# NEXT_PUBLIC_* values are inlined at build time: set them before
# `npm run build` for each environment. A built portal keeps the values it was
# built with. `npm run dev` reads them when the server starts.
#
# Each value must be an absolute https:// URL (http:// only for localhost or
# other loopback hosts), without credentials, query string, or fragment. An
# optional base path is allowed, e.g. https://apps.example.com/crm. A missing
# or invalid value shows that card as "configuration pending". The portal adds
# the selected locale, e.g. http://localhost:3100/ar.
NEXT_PUBLIC_CRM_APP_URL=http://localhost:3100
NEXT_PUBLIC_COMMUNITY_ADMIN_APP_URL=http://localhost:3200

# Account service (sign-in, sessions, subscriptions): built by Ability-Tech's
# backend team; contract in ../docs/ACCOUNT-SERVICE-API.md. Server-only values,
# read when the server starts: never prefix them with NEXT_PUBLIC_.
# Without them, sign-in reports that the service is unavailable.
ACCOUNT_SERVICE_URL=http://localhost:3400
ACCOUNT_SERVICE_CLIENT_ID=ability-portal
# Issued by the backend team. Keep it in .env.local only, never committed.
ACCOUNT_SERVICE_CLIENT_SECRET=

# Parent domain of the Portal and both products in deployed environments, e.g.
# apps.ability-tech.com, so they share the session cookie. Leave empty for
# localhost, where the apps share cookies across ports.
SESSION_COOKIE_DOMAIN=
